def title_buttons(st, hide):
    if hide:
        if "buttons" not in st:
            st["buttons"] = {g + "/" + k: kread(g, k) for g, k in BUTTON_KEYS}
            save_state(st)
        for g, k in BUTTON_KEYS:
            kwrite(g, k, "")
    elif "buttons" in st:
        for name, value in st.pop("buttons").items():
            g, k = name.split("/", 1)
            kwrite(g, k, value)
        save_state(st)


def visual(cmd, on):
    """corners: liga/desliga o efeito Rounded Corners (independente do tiling desde 2026-11-08).
    opacity: inativas a 90 % (Configurações › Janelas › Tiling), vale enquanto o tiling estiver ligado."""
