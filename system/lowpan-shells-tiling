bus = dbus.SessionBus()


class _KGA:
    """kglobalaccel só quando usado: no login, antes do KWin (que o hospeda no Plasma 6), ele não existe."""
    _i = None

    def __getattr__(self, name):
        if _KGA._i is None:
            _KGA._i = dbus.Interface(bus.get_object("org.kde.kglobalaccel", "/kglobalaccel"), "org.kde.KGlobalAccel")
        return getattr(_KGA._i, name)


kga = _KGA()


# ───────────────────────── kglobalaccel ─────────────────────────

def action_id(comp, act, cfn="", afn=""):
    return dbus.Array([comp, act, cfn, afn], signature="s")


def keys_of(comp, act):
    return [[int(k) for k in combo[0]] for combo in kga.shortcutKeys(action_id(comp, act))]


def set_keys_flags(aid, combos, flags):
    arr = dbus.Array([dbus.Struct([dbus.Array([dbus.Int32(k) for k in c], signature="i")], signature=None)
                      for c in combos], signature="(ai)")
    kga.setShortcutKeys(aid, arr, dbus.UInt32(flags))


def set_keys(aid, combos):
    set_keys_flags(aid, combos, NO_AUTOLOADING)


def owner_of(code):
    a = kga.action(dbus.Int32(code))
    return [str(x) for x in a] if a else None


# ───────────────────────── kwinrc ─────────────────────────

def kread(group, key):
    r = subprocess.run(["kreadconfig6", "--file", "kwinrc", "--group", group, "--key", key],
                       capture_output=True, text=True)
    v = r.stdout.strip()
    # kreadconfig6 não distingue "vazio" de "ausente": ausente = None (devolver = apagar a chave)
    return v if v != "" else None


def kwrite(group, key, value):
    if value is None:
        subprocess.run(["kwriteconfig6", "--file", "kwinrc", "--group", group, "--key", key, "--delete"])
    else:
        subprocess.run(["kwriteconfig6", "--file", "kwinrc", "--group", group, "--key", key, value])


def reconfigure():
    subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def effect(method, eid):
    try:
        dbus.Interface(bus.get_object("org.kde.KWin", "/Effects"), "org.kde.kwin.Effects").get_dbus_method(method)(eid)
    except dbus.DBusException:
        pass


def script_loaded(name):
    try:
        return bool(dbus.Interface(bus.get_object("org.kde.KWin", "/Scripting"), "org.kde.kwin.Scripting")
                    .isScriptLoaded(name))
    except dbus.DBusException:
        return False


def kwin_pid():
    r = subprocess.run(["pidof", "kwin_wayland"], capture_output=True, text=True)
    return r.stdout.strip().split(" ")[0] if r.stdout.strip() else ""


# ───────────────────────── estado ─────────────────────────

def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_state(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    os.replace(tmp, STATE)


def write_config(on):
    try:
        with open(CONFIG) as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        print(T("warning: config.json not read (%s); lowpan.tiling not written", "aviso: config.json não lido (%s); lowpan.tiling não gravado") % e, file=sys.stderr)
        return
    cfg.setdefault("lowpan", {})
    if cfg["lowpan"].get("tiling") == on:
        return
    cfg["lowpan"]["tiling"] = on
    tmp = CONFIG + ".lowpan-tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
    os.replace(tmp, CONFIG)


def read_lowpan_cfg():
    try:
        with open(CONFIG) as f:
            return json.load(f).get("lowpan", {})
    except (OSError, ValueError):
        return {}


