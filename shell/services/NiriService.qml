    function getCurrentOutputWorkspaceNumbers() {
        // Niri workspaces already expose a 1-based idx for their position on the monitor.
        // Use idx directly as the workspace number for the current output.
        return currentOutputWorkspaces.map(w => w.idx)
    }

    function getCurrentWorkspaceNumber() {
        // Return the 1-based idx of the focused workspace on the current output.
        if (focusedWorkspaceIndex >= 0 && focusedWorkspaceIndex < allWorkspaces.length) {
            return allWorkspaces[focusedWorkspaceIndex].idx
        }
        // Fallback to the first workspace index if nothing is focused.
        return 1
    }

    function getCurrentKeyboardLayoutName() {
        if (currentKeyboardLayoutIndex >= 0 && currentKeyboardLayoutIndex < keyboardLayoutNames.length) {
            return keyboardLayoutNames[currentKeyboardLayoutIndex]
        }
        return ""
    }

    function findNiriWindow(toplevel) {
        if (!toplevel.appId)
            return null

        for (var j = 0; j < windows.length; j++) {
            const niriWindow = windows[j]
            if (niriWindow.app_id === toplevel.appId) {
                if (!niriWindow.title || niriWindow.title === toplevel.title) {
                    return {
                        "niriIndex": j,
                        "niriWindow": niriWindow
                    }
                }
            }
        }
        return null
    }

    // Map ToplevelManager's wayland-foreign-toplevel handles to Niri's authoritative
    // window list. Niri's `windows` is the source of truth: if a window isn't in
    // it, it doesn't exist, even if Wayland still has a stale handle for it (which
    // happens for apps that don't release the handle cleanly on close — zen,
    // electron, etc.). Returning the unmatched handles unenriched would surface
    // those ghosts in the dock/taskbar, which is exactly the persistence bug we
    // want to avoid.
    function sortToplevels(toplevels) {
        if (!toplevels || !CompositorService.isNiri)
            return toplevels ? [...toplevels] : []

        // Niri authoritative: 0 windows => 0 toplevels, regardless of stale handles.
        if (windows.length === 0)
            return []

        // LowPan Shells: o KWin não expõe foreign-toplevel, então não há handle Wayland para casar e a dock
        // ficava só com os fixados. Cada janela da ponte vira um toplevel sintético; ativar e fechar
        // seguem pela ponte (focusWindow/closeWindow → _kwinTranslate).
        if (root.kwinMode) {
            return sortWindowsByLayout(windows).map(w => enrichToplevel({
                "appId": w.app_id ?? "",
                "title": w.title ?? "",
                "close": function () { return NiriService.closeWindow(w.id) }
            }, w))
        }

        const usedToplevels = new Set()
        const enrichedToplevels = []

        for (const niriWindow of sortWindowsByLayout(windows)) {
            let bestMatch = null
            let bestScore = -1

            for (const toplevel of toplevels) {
                if (usedToplevels.has(toplevel))
                    continue

                const score = matchToplevelToWindow(toplevel, niriWindow)
                if (score > bestScore) {
                    bestScore = score
                    bestMatch = toplevel
                    if (score === 3)
                        break
                }
            }

            if (!bestMatch || bestScore <= 0)
                continue

            usedToplevels.add(bestMatch)
            enrichedToplevels.push(enrichToplevel(bestMatch, niriWindow))
        }

        // Intentionally DO NOT append unmatched toplevels: any toplevel without a
        // Niri window counterpart is a stale Wayland handle (ghost) and including
        // it would resurrect closed apps in the dock.
        return enrichedToplevels
    }

    function matchToplevelToWindow(toplevel, niriWindow) {
        if (toplevel.appId !== niriWindow.app_id)
            return 0

        let score = 1
        if (niriWindow.title && toplevel.title) {
            if (toplevel.title === niriWindow.title) {
                score = 3
            } else if (toplevel.title.includes(niriWindow.title) || niriWindow.title.includes(toplevel.title)) {
                score = 2
            }
        }
        return score
    }

    function enrichToplevel(toplevel, niriWindow) {
        const workspace = workspaces[niriWindow.workspace_id]
        const isFocused = niriWindow.is_focused ?? (workspace && workspace.active_window_id === niriWindow.id) ?? false
        const windowId = niriWindow.id

        const enriched = {
            "appId": toplevel.appId,
            "title": toplevel.title,
            "activated": isFocused,
            "niriWindowId": windowId,
            "niriWorkspaceId": niriWindow.workspace_id,
            "_sourceKey": `niri:${windowId}`,
            "_sourceToplevel": toplevel,
            "activate": function () {
                return NiriService.focusWindow(windowId)
            },
            "close": function () {
                if (toplevel.close) {
                    return toplevel.close()
                }
                return false
            }
        }

        for (let prop in toplevel) {
            if (!(prop in enriched)) {
                enriched[prop] = toplevel[prop]
            }
        }

        return enriched
    }

    function hasWindowsOnActiveWorkspace(outputName: string): bool {
        const active = Object.values(root.workspaces ?? {}).filter(workspace => workspace?.is_active
            && (outputName.length === 0 || workspace.output === outputName))
        if (active.length === 0 || !Array.isArray(root.windows)) return false
        return root.windows.some(window => !window?.is_minimized
            && active.some(workspace => workspace.id === window.workspace_id))
    }

    // True when the tiled columns of the output's active workspace span its width,
    // so only gaps of the wallpaper remain visible.
    function activeWorkspaceCovers(outputName: string): bool {
        const workspace = Object.values(root.workspaces ?? {}).find(entry => entry?.is_active && entry.output === outputName)
        const width = Number(root.outputs?.[outputName]?.logical?.width ?? 0)
        if (!workspace || width <= 0 || !Array.isArray(root.windows)) return false
        if (root.kwinMode && root.kwinShowingDesktop) return false // LowPan Shells: Meta+D mostra o fundo
        const columns = {}
        for (const window of root.windows) {
            const pos = window?.layout?.pos_in_scrolling_layout
            if (window?.workspace_id !== workspace.id || window.is_floating || window.is_minimized || !pos) continue
            columns[pos[0]] = Math.max(columns[pos[0]] ?? 0, Number(window.layout?.tile_size?.[0] ?? 0))
        }
        return Object.values(columns).reduce((sum, column) => sum + column, 0) >= width * 0.95
    }

    function filterCurrentWorkspace(toplevels, screenName) {
        let currentWorkspaceId = null

        for (const workspace of allWorkspaces) {
            if (workspace.output === screenName && workspace.is_active) {
                currentWorkspaceId = workspace.id
                break
            }
        }

        if (currentWorkspaceId === null)
            return toplevels

        const workspaceWindows = windows.filter(window =>
            window.workspace_id === currentWorkspaceId)
        const usedToplevels = new Set()
        const result = []

        for (const niriWindow of workspaceWindows) {
            let bestMatch = null
            let bestScore = -1

            for (const toplevel of toplevels) {
                if (usedToplevels.has(toplevel))
                    continue

                const score = matchToplevelToWindow(toplevel, niriWindow)
                if (score > bestScore) {
                    bestScore = score
                    bestMatch = toplevel
                    if (score === 3)
                        break
                }
            }

            if (!bestMatch || bestScore <= 0)
                continue

            usedToplevels.add(bestMatch)
            result.push(enrichToplevel(bestMatch, niriWindow))
        }

        return result
    }

    // ========== TILING LAYOUTS ==========

    property string currentLayout: "off"
    readonly property var layouts: ["off", "master-left", "master-right", "columns", "monocle"]
    readonly property int tilingWindowCount: _currentWorkspaceWindows.length
    readonly property var _currentWorkspaceWindows: {
        const focusedWs = allWorkspaces.find(ws => ws.is_focused)
        if (!focusedWs) return []
        return windows.filter(w => w.workspace_id === focusedWs.id && !w.is_floating)
    }

    signal layoutChanged(string layout)
    signal layoutApplied(string layout, int windowCount)

    // LowPan Tiling: no KWin os layouts são ações do motor (shell/kwin-tiling, §21.16); ele confirma com "tilingPreset"
    readonly property var _kwinPresetShortcut: ({
        "off": "LowPanTilingNiriPresetOff", "master-left": "LowPanTilingNiriPresetMasterLeft",
        "master-right": "LowPanTilingNiriPresetMasterRight", "columns": "LowPanTilingNiriPresetColumns",
        "monocle": "LowPanTilingNiriPresetMonocle"
    })
    function _kwinShortcut(name: string): void {
        root.kwinSend({ action: "invokeShortcut", component: "kwin", name: name })
    }

    function cycleLayout(): void {
        if (CompositorService.isKWin) { root._kwinShortcut("LowPanTilingNiriPresetCycle"); return }
        const idx = layouts.indexOf(currentLayout)
        const nextIdx = (idx + 1) % layouts.length
        applyLayout(layouts[nextIdx])
    }

    function applyLayout(layoutName): void {
        if (CompositorService.isKWin) {
            const shortcut = root._kwinPresetShortcut[layoutName]
            if (shortcut) root._kwinShortcut(shortcut)
            return
        }
        if (!CompositorService.isNiri) return
        const wins = _currentWorkspaceWindows
        if (wins.length === 0) {
            currentLayout = layoutName
            layoutChanged(layoutName)
            return
        }

        // Reset: expel all windows to separate columns
        _resetLayout(wins.length)

        // Apply layout after reset
        _layoutTimer.layoutName = layoutName
        _layoutTimer.windowCount = wins.length
        _layoutTimer.start()
    }

    function _resetLayout(count): void {
        focusColumnFirst()
        for (let i = 0; i < count + 2; i++) {
            expelWindowFromColumn()
        }
    }

    Timer {
        id: _layoutTimer
        interval: 100
        property string layoutName: "off"
        property int windowCount: 0
        onTriggered: {
            switch (layoutName) {
                case "master-left": root._applyMasterLeft(windowCount); break
                case "master-right": root._applyMasterRight(windowCount); break
                case "columns": root._applyColumns(windowCount); break
                case "monocle": root._applyMonocle(windowCount); break
                default: break // "off" - already reset
            }
            root.currentLayout = layoutName
            root.layoutChanged(layoutName)
            root.layoutApplied(layoutName, windowCount)
        }
    }

    function _applyMasterLeft(count): void {
        if (count < 2) return
        // Master en col 0 (50%), stack en col 1
        focusColumnFirst()
        setColumnWidth("50%")
        focusColumnRight()
        // Consume todas las ventanas restantes hacia col 1
        for (let i = 0; i < count - 2; i++) {
            consumeWindowIntoColumn()
        }
    }

    function _applyMasterRight(count): void {
        if (count < 2) return
        // Stack en col 0, Master en col 1 (50%)
        // Primero: consumir todas excepto la última en col 0
        focusColumnFirst()
        for (let i = 0; i < count - 2; i++) {
            consumeWindowIntoColumn()
        }
        // Ahora tenemos 2 columnas: stack (col 0) y master (col 1)
        focusColumnRight()
        setColumnWidth("50%")
    }

    function _applyColumns(count): void {
        if (count < 1) return
        const width = Math.floor(100 / count) + "%"
        focusColumnFirst()
        for (let i = 0; i < count; i++) {
            setColumnWidth(width)
            focusColumnRight()
        }
    }

    function _applyMonocle(count): void {
        if (count < 1) return
        focusColumnFirst()
        setColumnWidth("100%")
        for (let i = 0; i < count - 1; i++) {
            consumeWindowIntoColumn()
        }
    }

    function promoteToMaster(): void {
        if (CompositorService.isKWin) { root._kwinShortcut("LowPanTilingNiriPresetPromote"); return }
        if (!CompositorService.isNiri) return
        if (currentLayout === "master-left") {
            moveColumnToFirst()
        } else if (currentLayout === "master-right") {
            moveColumnToLast()
        }
    }

    IpcHandler {
        target: "keyboard"

        function switchLayout(): void {
            NiriService.switchLayout()
        }

        function switchLayoutPrevious(): void {
            NiriService.switchLayoutPrevious()
        }

        function getCurrentLayout(): string {
            return NiriService.getCurrentKeyboardLayoutName()
        }

        function getLayouts(): string {
            return JSON.stringify(NiriService.keyboardLayoutNames)
        }
    }


    // =====================================================================================
    // LowPan Shells — backend KWin
    // No Plasma o CompositorService marca isKWin = true e isNiri = true (modo compatível). Os dados
    // chegam pela ponte (kwin-bridge/helper → KWin Script) e são convertidos para os mesmos eventos
    // do Niri, então todo o resto do shell funciona sem saber que é o KWin. As ações do Niri que
    // chegam em send() são traduzidas em _kwinTranslate().
    // =====================================================================================
    readonly property bool kwinMode: CompositorService.isKWin
    readonly property var kwinGameModeExempt: ["org.kde.spectacle", "spectacle", "org.kde.krunner", "krunner",
        "flameshot", "org.flameshot.flameshot", "org.kde.kruler", "kruler", "org.kde.plasma.emojier"]
    property bool kwinBridgeReady: false
    property var _kwinWinIds: ({})     // uuid do KWin -> id numérico estável (ordem de chegada)
    property var _kwinWinUuids: ({})   // id numérico -> uuid
    property int _kwinNextWinId: 1
    property var _kwinDeskIds: ({})
    property var _kwinDeskUuids: ({})
    property int _kwinNextDeskId: 1
    property int _kwinActiveId: -1
    // Meta+D (Espiar área de trabalho): as janelas somem sem minimizar; quem mede "tela coberta" precisa saber.
    property bool kwinShowingDesktop: false
    // LowPan Tiling: colunas em abas que o motor (fork do Krohnkite) publica pela ponte; as barras são do shell
    property var kwinTabColumns: []
    /** LowPan Tiling: uma janela está sendo arrastada no tiling (o papel de parede desfoca) */
    property bool kwinTilingDragging: false
    /** LowPan Tiling: janela arrastada (id do motor). Fica até o motor publicar as abas de novo depois de soltar
     *  (ou 1,5 s): a barra de abas some com a aba dela na hora, sem esperar a coluna nova */
    property string kwinTilingDragId: ""
    property Timer _kwinDragIdClear: Timer {
        interval: 1500
        onTriggered: root.kwinTilingDragId = ""
    }
    property int kwinTabBarHeight: 36
    property string kwinCurrentDesktop: ""
    property var _kwinRaw: ({})        // id numérico -> janela crua da ponte (minimizada, geometria...)

    function _kwinWinId(uuid: string): int {
        let id = root._kwinWinIds[uuid]
        if (id === undefined) {
            id = root._kwinNextWinId++
            root._kwinWinIds[uuid] = id
            root._kwinWinUuids[id] = uuid
        }
        return id
    }

    function _kwinDeskId(uuid: string): int {
        let id = root._kwinDeskIds[uuid]
        if (id === undefined) {
            id = root._kwinNextDeskId++
            root._kwinDeskIds[uuid] = id
            root._kwinDeskUuids[id] = uuid
        }
        return id
    }

    function kwinSend(obj): bool {
        if (!kwinBridge.running)
            return false
        kwinBridge.write(JSON.stringify(obj) + "\n")
        return true
    }

    function _kwinOutputs(): var {
        const out = {}
        for (const scr of Quickshell.screens) {
            out[scr.name] = {
                name: scr.name, make: scr.manufacturer ?? "", model: scr.model ?? "",
                logical: { x: scr.x, y: scr.y, width: scr.width, height: scr.height,
                           scale: scr.devicePixelRatio ?? 1, transform: "Normal" },
                current_mode: 0, modes: []
            }
        }
        return out
    }

    function _kwinOnLine(line: string): void {
        let msg
        try { msg = JSON.parse(line) } catch (e) { console.warn("[KWinBridge] linha inválida:", line); return }
        switch (msg.type) {
        case "layerAdded":
            KWinLayoutKick.kick()
            break
        case "hello":
            root.kwinBridgeReady = true
            if (root.kwinAppMenuUsers > 0) root.kwinSend({ action: "appMenuEnable" }) // ponte reiniciada
            KWinLayoutKick.kick()
            root.handleOutputsChanged({ outputs: root._kwinOutputs() })
            root.configLoaded = true
            break
        case "snapshot":
            root._kwinApplySnapshot(msg)
            break
        case "tilingPreset": // LowPan Tiling: o motor aplicou um layout do iNiR (o tilingOverlay mostra o aviso)
            root.currentLayout = String(msg.layout ?? "off")
            root.layoutChanged(root.currentLayout)
            root.layoutApplied(root.currentLayout, Number(msg.count ?? 0))
            break
        case "tilingDrag": // LowPan Tiling: começo/fim do arrasto de uma janela (desfoque do papel de parede)
            root.kwinTilingDragging = !!msg.dragging
            if (msg.dragging) {
                root._kwinDragIdClear.stop()
                root.kwinTilingDragId = String(msg.id ?? "")
            } else if (root.kwinTilingDragId !== "") {
                root._kwinDragIdClear.restart()
            }
            break
        case "tiling": // LowPan Tiling: barras de abas (modules/tilingTabs)
            if (!root.kwinTilingDragging && root.kwinTilingDragId !== "") { // soltou: chegou a coluna nova
                root._kwinDragIdClear.stop()
                root.kwinTilingDragId = ""
            }
            root.kwinTabColumns = msg.tabs ?? []
            root.kwinTabBarHeight = msg.bar ?? 36
            break
        case "showingDesktop": // LowPan Shells: vem do DBus do KWin, pelo helper
            root.kwinShowingDesktop = !!msg.showing
            break
        case "keyboard":
            root.applyKeyboardLayouts({ names: (msg.layouts ?? []).map(l => l.name), current_idx: msg.current ?? 0 })
            break
        case "appMenu": // LowPan Shells (§21.35): menu real do app em foco (barra de menu estilo macOS)
            root.kwinAppMenu = { pid: Number(msg.pid ?? 0), service: String(msg.service ?? ""), path: String(msg.path ?? ""), menus: msg.menus ?? [] }
            break
        case "appMenuSub": { // filhos de um menu atualizados no AboutToShow (ex.: "Abrir recente")
            const cur = root.kwinAppMenu
            if (cur.service !== String(msg.service ?? "") || cur.path !== String(msg.path ?? ""))
                break
            const patch = list => (list ?? []).map(item => item.id === msg.id
                ? Object.assign({}, item, { children: msg.children ?? [] })
                : (item.children && item.children.length ? Object.assign({}, item, { children: patch(item.children) }) : item))
            root.kwinAppMenu = Object.assign({}, cur, { menus: patch(cur.menus) })
            break
        }
        case "error":
            console.warn("[KWinBridge]", msg.message)
            break
        }
    }

    function _kwinApplySnapshot(snap): void {
        const outputName = Quickshell.screens.length > 0 ? Quickshell.screens[0].name : ""
        const cur = snap.currentDesktop
        root.kwinCurrentDesktop = String(cur ?? "")
        const activeUuid = snap.activeId || ""
        const activeInt = activeUuid ? root._kwinWinId(activeUuid) : -1

        // janela → área "principal" (KWin permite várias áreas ou todas)
        const wsOf = w => (w.onAllDesktops || !w.desktops || w.desktops.length === 0 || w.desktops.includes(cur))
            ? cur : w.desktops[0]

        const raw = {}
        const windows = (snap.windows ?? []).map((w, stackIndex) => {
            const id = root._kwinWinId(w.id)
            raw[id] = w
            const g = w.geometry ?? { x: 0, y: 0, width: 0, height: 0 }
            return {
                id: id,
                title: w.caption,
                app_id: w.appId,
                pid: w.pid,
                workspace_id: root._kwinDeskId(wsOf(w)),
                is_focused: id === activeInt && !w.minimized,
                is_floating: false,
                is_urgent: !!w.demandsAttention,
                layout: {
                    pos_in_scrolling_layout: [id, 1], // ordem estável = ordem de abertura
                    tile_size: [g.width, g.height],
                    window_size: [g.width, g.height],
                    tile_pos_in_workspace_view: null,
                    window_offset_in_tile: [0, 0]
                },
                // extras do KWin (não existem no Niri)
                kwin_uuid: w.id,
                resource_class: w.resourceClass ?? "", // apps que sempre flutuam (KWinFloatApps)
                // Ferramentas de captura/sobreposição ocupam a tela inteira mas não são "jogo":
                // não devem ligar o GameMode (que desliga efeitos e recria o fundo ao sair).
                gamemode_exempt: root.kwinGameModeExempt.includes(String(w.appId).toLowerCase())
                    || root.kwinGameModeExempt.includes(String(w.resourceClass).toLowerCase()),
                is_minimized: !!w.minimized,
                is_maximized: !!w.maximized,
                is_fullscreen: !!w.fullScreen,
                geometry: g,
                // LowPan Shells: para o seletor de captura (clicar numa janela) — ordem de empilhamento
                // (maior = por cima), monitor e se está visível na área de trabalho atual.
                kwin_stack: stackIndex,
                kwin_output: w.output ?? "",
                kwin_visible: !w.minimized && wsOf(w) === cur
            }
        })
        root._kwinRaw = raw

        const activeWs = activeInt >= 0 && raw[activeInt] ? root._kwinDeskId(wsOf(raw[activeInt])) : -1
        const workspaces = (snap.desktops ?? []).map((d, i) => {
            const id = root._kwinDeskId(d.id)
            const winOnDesk = windows.find(w => w.workspace_id === id && w.id === activeInt)
            return {
                id: id, idx: i + 1, name: d.name, output: outputName,
                is_active: d.id === cur, is_focused: d.id === cur, is_urgent: false,
                active_window_id: winOnDesk ? activeInt : null
            }
        })

        root.handleWorkspacesChanged({ workspaces: workspaces })
        root.handleWindowsChanged({ windows: windows })
        if (activeInt !== root._kwinActiveId) {
            root._kwinActiveId = activeInt
            root.handleWindowFocusChanged({ id: activeInt >= 0 ? activeInt : null })
        }
    }

    function _kwinDeskByRef(ref): string {
        if (!ref) return ""
        if (ref.Id !== undefined) return root._kwinDeskUuids[ref.Id] ?? ""
        if (ref.Index !== undefined) {
            const ws = root.allWorkspaces.find(w => w.idx === ref.Index)
            return ws ? (root._kwinDeskUuids[ws.id] ?? "") : ""
        }
        if (ref.Name !== undefined) {
            const ws = root.allWorkspaces.find(w => w.name === ref.Name)
            return ws ? (root._kwinDeskUuids[ws.id] ?? "") : ""
        }
        return ""
    }

    // Ações do Niri → comandos da ponte. Ações de coluna/scroll do Niri não têm equivalente
    // (quem organiza as janelas é o Krohnkite) e são ignoradas.
    function _kwinTranslate(request): bool {
        const action = request?.Action
        if (!action) return false
        const kind = Object.keys(action)[0]
        const v = action[kind] ?? {}
        const uuidOf = id => root._kwinWinUuids[id ?? root._kwinActiveId] ?? ""
        switch (kind) {
        case "FocusWindow":
            return root.kwinSend({ action: "activate", id: uuidOf(v.id) })
        case "CloseWindow":
            return root.kwinSend({ action: "close", id: uuidOf(v.id) })
        case "FocusWorkspace": {
            const d = root._kwinDeskByRef(v.reference)
            return d ? root.kwinSend({ action: "setDesktop", desktop: d }) : false
        }
        case "FocusWorkspaceUp":
        case "FocusWorkspacePrevious":
            return root.kwinSend({ action: "desktopPrev" })
        case "FocusWorkspaceDown":
            return root.kwinSend({ action: "desktopNext" })
        case "MoveWindowToWorkspace": {
            const d = root._kwinDeskByRef(v.reference)
            return d ? root.kwinSend({ action: "moveToDesktop", id: uuidOf(v.window_id), desktop: d, focus: !!v.focus }) : false
        }
        case "ToggleOverview":
            return root.kwinSend({ action: "invokeShortcut", component: "kwin", name: "Overview" })
        case "SwitchLayout":
            return root.kwinSend({ action: v.layout === "Prev" ? "keyboardPrev" : "keyboardNext" })
        case "Quit":
            return root.kwinSend({ action: "logout", kind: v?.skip_confirmation ? "direct" : "" })
        case "FullscreenWindow":
        case "MaximizeWindowToEdges":
            return root.kwinSend({ action: "maximize", id: uuidOf(v.id) })
        default:
            return false
        }
    }

    // Extras do KWin para quem quiser usar diretamente (dock: clique ativa/minimiza)
    function kwinToggleWindow(windowId: int): bool { return root.kwinSend({ action: "toggle", id: root._kwinWinUuids[windowId] ?? "" }) }
    function kwinMinimizeWindow(windowId: int): bool { return root.kwinSend({ action: "minimize", id: root._kwinWinUuids[windowId] ?? "" }) }
    function kwinShowDesktop(): bool { return root.kwinSend({ action: "showDesktop" }) }
    // LowPan Shells (§21.35): menu real do app (a ponte acha o menu DBus pelo pid da janela).
    property var kwinAppMenu: ({ pid: 0, service: "", path: "", menus: [] })
    // Quantas barras de menu estão na tela (uma por monitor): o leitor de menus só fica ligado com alguma.
    property int kwinAppMenuUsers: 0
    onKwinAppMenuUsersChanged: root.kwinSend({ action: root.kwinAppMenuUsers > 0 ? "appMenuEnable" : "appMenuDisable" })
    function kwinAppMenuLoad(pid: int): bool { return root.kwinSend({ action: "appMenuLoad", pid: pid }) }
    function kwinAppMenuOpen(id: int): bool {
        const m = root.kwinAppMenu
        return m.service !== "" && root.kwinSend({ action: "appMenuOpen", service: m.service, path: m.path, id: id })
    }
    function kwinAppMenuClick(id: int): bool {
        const m = root.kwinAppMenu
        return m.service !== "" && root.kwinSend({ action: "appMenuClick", service: m.service, path: m.path, id: id })
    }
    // LowPan Shells (barra de menu estilo macOS, §21.33): menu "Janela"
    function kwinActivateWindow(windowId: int): bool { return root.kwinSend({ action: "activate", id: root._kwinWinUuids[windowId] ?? "" }) }
    function kwinCloseWindow(windowId: int): bool { return root.kwinSend({ action: "close", id: root._kwinWinUuids[windowId] ?? "" }) }
    function kwinMaximizeWindow(windowId: int): bool { return root.kwinSend({ action: "maximize", id: root._kwinWinUuids[windowId] ?? "" }) }
    function kwinFullscreenWindow(windowId: int): bool { return root.kwinSend({ action: "fullscreen", id: root._kwinWinUuids[windowId] ?? "" }) }
    function kwinKeepAboveWindow(windowId: int): bool { return root.kwinSend({ action: "keepAbove", id: root._kwinWinUuids[windowId] ?? "" }) }

    Process {
        id: kwinBridge
        running: root.kwinMode
        stdinEnabled: true
        command: [Quickshell.shellPath("kwin-bridge/helper/lowpan-kwin-bridge")]
        stdout: SplitParser { onRead: line => root._kwinOnLine(line) }
        stderr: SplitParser { onRead: line => console.warn("[KWinBridge:stderr]", line) }
        onExited: (code, status) => {
            root.kwinBridgeReady = false
            console.warn("[KWinBridge] ponte saiu com código", code)
            if (root.kwinMode) kwinBridgeRestart.restart()
        }
    }
    Timer { id: kwinBridgeRestart; interval: 2000; onTriggered: if (root.kwinMode) kwinBridge.running = true }

    Connections {
        target: Quickshell
        enabled: root.kwinMode
        function onScreensChanged(): void { root.handleOutputsChanged({ outputs: root._kwinOutputs() }) }
    }

}
