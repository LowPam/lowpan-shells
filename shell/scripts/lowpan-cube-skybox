#!/usr/bin/env python3
"""LowPan Shells — monta o fundo ("SkyBox") do efeito Cubo do KWin a partir de um papel de parede.

uso: lowpan-cube-skybox <imagem-ou-vídeo> <saída.jpg> [desfoque]

O cubo estica a imagem num céu de 360°×180° e a câmera vê só ~108°×60° dele: o papel de parede aparece ampliado ~3×
e granula. Como a imagem nunca é vista inteira, ela vai esticada como o cubo espera (2:1) e com um desfoque leve que
some com o granulado. Vídeo vira um quadro representativo.
"""
import os
import subprocess
import sys
import tempfile

W, H = 4096, 2048          # 2:1 (equiretangular); mais que isso só ampliaria o mesmo granulado
VIDEO = (".mp4", ".webm", ".mkv", ".avi", ".mov", ".m4v")


def ffmpeg(*args: str) -> None:
    subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-threads", "2", *args], check=True)


def main() -> int:
    if len(sys.argv) < 3:
        print(__doc__, file=sys.stderr)
        return 2
    src, out = sys.argv[1], sys.argv[2]
    sigma = float(sys.argv[3]) if len(sys.argv) > 3 else 6
    with tempfile.TemporaryDirectory() as tmp:
        if src.lower().endswith(VIDEO):  # um quadro representativo, com memória baixa (ver Wallpapers.qml)
            frame = os.path.join(tmp, "frame.png")
            try:
                ffmpeg("-ss", "1", "-i", src, "-an", "-vf", "select='not(mod(n\\,3))',thumbnail=n=10", "-frames:v", "1", "-update", "1", frame)
            except subprocess.CalledProcessError:
                ffmpeg("-i", src, "-frames:v", "1", "-update", "1", frame)
            src = frame
        blur = f",gblur=sigma={sigma}" if sigma > 0 else ""
        ffmpeg("-i", src, "-frames:v", "1", "-vf", f"scale={W}:{H}:flags=lanczos{blur}", "-q:v", "2", out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
