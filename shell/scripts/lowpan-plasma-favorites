#!/usr/bin/env python3
"""LowPan Shells — lista os favoritos do Kickoff (Plasma) como JSON: ["org.kde.dolphin", "firefox", ...].

Fonte: a ordem gravada em ~/.config/kactivitymanagerd-statsrc (a lista "-global" mais completa entre os
lançadores) e, depois dela, os favoritos do banco do kactivitymanagerd que a ordem não cita. "preferred://browser"
vira o navegador padrão. Só lê; apps desinstalados ficam de fora.
"""
import configparser
import json
import os
import sqlite3
import subprocess

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")


def browser():
    try:
        out = subprocess.run(["xdg-settings", "get", "default-web-browser"], capture_output=True, text=True, timeout=3).stdout
        return out.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def to_id(resource):
    if resource == "preferred://browser":
        resource = browser() or ""
    if resource.startswith("applications:"):
        resource = resource[len("applications:"):]
    if not resource.endswith(".desktop"):
        return None
    return resource[: -len(".desktop")]


def installed(app):
    dirs = [os.path.join(DATA, "applications")]
    dirs += [os.path.join(d, "applications") for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")]
    dirs += [os.path.join(DATA, "flatpak/exports/share/applications"), "/var/lib/flatpak/exports/share/applications"]
    return any(os.path.exists(os.path.join(d, app + ".desktop")) for d in dirs)


def orderings():
    parser = configparser.RawConfigParser(strict=False)
    try:
        parser.read(os.path.join(CONFIG, "kactivitymanagerd-statsrc"))
    except configparser.Error:
        return []
    out = []
    for section in parser.sections():
        if section.startswith("Favorites-") and section.endswith("-global") and parser.has_option(section, "ordering"):
            out.append([r for r in parser.get(section, "ordering").split(",") if r])
    return out


def linked():
    path = os.path.join(DATA, "kactivitymanagerd", "resources", "database")
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        rows = db.execute("select targettedResource from ResourceLink "
                          "where initiatingAgent = 'org.kde.plasma.favorites.applications' order by rowid").fetchall()
        db.close()
        return [r[0] for r in rows]
    except sqlite3.Error:
        return []


def main():
    lists = orderings()
    # a lista com mais apps ainda instalados é a do lançador em uso
    score = lambda lst: sum(1 for r in lst if (a := to_id(r)) and installed(a))
    first = max(lists, key=score) if lists else []
    ids = []
    for resource in first + linked():
        app = to_id(resource)
        if app and app not in ids and installed(app):
            ids.append(app)
    print(json.dumps(ids))


if __name__ == "__main__":
    main()
