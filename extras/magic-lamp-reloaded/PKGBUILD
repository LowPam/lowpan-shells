pkgname=kwin-effects-yet-another-magic-lamp-reloaded-git
pkgver=6.6.r23.gf6dbfcf
pkgrel=2
pkgdesc="(LowPan: fallback sem painel) Fork of Yet Another Magic Lamp, targeting Plasma 6.6+ with exclusive Wayland support"
arch=('x86_64')
url="https://github.com/koryboc/kwin-effects-yet-another-magic-lamp-reloaded"
license=('GPL-2.0-only')
depends=(
    'kwin'
    'qt6-base'
    'kcmutils'
    'kconfig'
    'kconfigwidgets'
    'kcoreaddons'
    'kwindowsystem'
    'libdrm'
)
makedepends=('cmake' 'extra-cmake-modules' 'git' 'vulkan-headers')
source=("${pkgname}::git+${url}.git"
        "lowpan-fallback-sem-painel.patch")
sha256sums=('SKIP' 'SKIP')

pkgver() {
    cd "$pkgname"
    git describe --long --tags --match "[0-9]*" | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$pkgname"
    patch -Np1 -i ../lowpan-fallback-sem-painel.patch
}

build() {
    cmake -B build -S "$pkgname" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
